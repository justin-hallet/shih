{
  "name": "space-harrier-infinite-horizons",
  "version": "0.1.0",
  "description": "An open-world reimagining of the classic Space Harrier arcade game with procedural generation and modern 3D graphics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,js --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,js --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true vite build"
  },
  "keywords": [
    "game",
    "space-harrier",
    "three.js",
    "procedural-generation",
    "pwa",
    "typescript",
    "webgl"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "compression": "^1.8.1",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-glsl": "^1.5.1",
    "vite-plugin-pwa": "^1.0.3",
    "vite-plugin-static-copy": "^3.1.2",
    "workbox-window": "^7.3.0"
  },
  "dependencies": {
    "@types/howler": "^2.2.12",
    "ammo.js": "^0.0.10",
    "howler": "^2.2.4",
    "three": "^0.180.0"
  }
}
